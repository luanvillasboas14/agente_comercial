# Copie para ".env" na raiz do projeto e preencha os valores.
# Nunca commite o arquivo ".env".

# ── Servidor Node (npm run server / produção) ──
PORT=8000

# OpenAI (obrigatório para job de feedback comercial, agente, inscrição, etc.)
OPENAI_API_KEY=

# Opcional: pré-preenche a chave no Playground (Vite expõe ao browser — use só em dev)
# VITE_OPENAI_API_KEY=

# Modelo só do job de feedback comercial (default gpt-4o-mini)
# FEEDBACK_JOB_OPENAI_MODEL=gpt-4o-mini

# Modelo do analisador de prompt (Otimizador de Prompt)
# Default: o3-mini. Esse modelo é caro/lento — só roda quando você clica "Analisar".
# OPENAI_MODEL_PROMPT_OPTIMIZER=o3-mini

# ── Supabase: base principal (IA / vetores / inscrição / distribuição) ──
SUPABASE_URL=
SUPABASE_KEY=
# Tabela de memória do agente (n8n Postgres Chat Memory). Default: n8n_chat_histories
# N8N_MEMORY_TABLE=n8n_chat_histories
# distrib_comercial (consultores): por padrão usa SUPABASE_*_FEEDBACK abaixo.
# Override opcional:
# SUPABASE_URL_DIST_COMERCIAL=
# SUPABASE_KEY_DIST_COMERCIAL=
# Alternativa se o front precisar (dev): pode repetir com prefixo VITE_
# VITE_SUPABASE_URL=
# VITE_SUPABASE_KEY=

# ── Supabase: feedback comercial (tabelas do job) ──
SUPABASE_URL_FEEDBACK=
SUPABASE_KEY_FEEDBACK=
# VITE_SUPABASE_URL_FEEDBACK=
# VITE_SUPABASE_KEY_FEEDBACK=

# ── Google Maps (tool localização / polos) ──
GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=

# Opcional: outro projeto só para tabela polo_loc
# SUPABASE_POLO_URL=
# SUPABASE_POLO_KEY=
# SUPABASE_POLO_TABLE=polo_loc

# ── Kommo (tool inscrição) ──
# URL da conta (sem barra no final). Teste: GET {KOMMO_BASE_URL}/api/v4/account
KOMMO_BASE_URL=https://admamoeduitcombr.kommo.com
KOMMO_ACCESS_TOKEN=

# Opcionais (o código tem defaults do fluxo antigo se omitir)
# KOMMO_SALESBOT_BOT_ID=46605
# KOMMO_PIPELINE_ID=5481944
# KOMMO_STATUS_ID=48539246
# Opcional — etapa “Aguardando inscrição” (default no código: 99045180, mesmo funil)
# KOMMO_STATUS_AGUARDANDO_INSCRICAO=99045180
# Distribuição humana (defaults no código = fluxo n8n tool distribuir.txt)
# KOMMO_DISTRIB_PIPELINE_ID=11685120
# KOMMO_DISTRIB_STATUS_IDS=89820300,89820304
# KOMMO_DISTRIB_ASSIGN_STATUS_ID=89820300
# KOMMO_DISTRIB_FINAL_PIPELINE_ID=5481944
# KOMMO_DISTRIB_FINAL_STATUS_ID=48539246
# Por padrão a tool distribui qualquer lead independente da etapa atual.
# Para reativar o filtro "lead precisa estar em pipeline X com status Y/Z",
# defina abaixo (não recomendado fora de cenários específicos):
# KOMMO_DISTRIB_REQUIRE_ELIGIBLE_STATUS=true
# Campo select “Recebida” — se o PATCH falhar, defina o enum_id numérico do Kommo:
# KOMMO_DIST_ORIGEM_ENUM_ID=
# Só testes locais: simula nome/nível no POST /api/inscricao/run (body _test_*)
# INSCRICAO_TEST_OVERRIDES=true

# ── Filtro por funil/status (scheduler periódico) ──
# A IA só responde a leads que estão no pipeline + status configurados.
# O webhook só BUFFERIZA mensagens; quem decide quando responder é o
# scheduler, que roda em loop (default 30s) listando leads no funil e
# processando o buffer dos que estão dentro.
#
# Vantagens vs gate por mensagem:
#   • 1 chamada no Kommo por tick (não importa quantas msgs cheguem).
#   • Tolerante a delay: lead movido pro funil DEPOIS de mandar mensagem
#     ainda recebe resposta — o próximo tick pega.
# Mensagens de leads que NUNCA entram no funil expiram via TTL do buffer
# (MESSAGE_BUFFER_TTL_SEC, default 600s = 10 min).
#
# Sem essas envs configuradas, o scheduler fica desligado e a IA não
# responde ninguém pelo webhook (responde só pelo /api/agent/run e pelo
# playground, que ignoram o filtro).
# KOMMO_AGENT_PIPELINE_ID=11685120
# KOMMO_AGENT_STATUS_ID=89820300
# Intervalo do loop (default 10s — agressivo p/ resposta rápida).
# Aumente para 30s se quiser reduzir chamadas ao Kommo/dispatcher.
# KOMMO_SCHEDULER_INTERVAL_SEC=10
# Silêncio mínimo após a última mensagem antes de processar (default 5s).
# Equivalente ao debounce: dá tempo do lead terminar de digitar várias
# mensagens em sequência antes da IA juntar tudo e responder.
# Aumente p/ 10-15s se os leads costumam mandar várias msgs em sequência
# e você prefere agrupar (perde ~10s de latência percebida).
# KOMMO_SCHEDULER_DEBOUNCE_SEC=5
# Liga/desliga sem precisar tirar pipeline/status (default true).
# KOMMO_SCHEDULER_ENABLED=true
# Loga URLs de inspeção do poll (notes/events) quando buffer vazio — útil sem whitelist de teste.
# KOMMO_SCHEDULER_VERBOSE=true
# Modo TESTE: lista CSV de lead ids permitidos. Quando setado, a IA SÓ
# responde leads dessa lista (E que estão no funil/status acima). Útil
# pra validar em produção sem afetar leads reais. Vazio = responde todo
# mundo do funil. Apague depois do teste.
# KOMMO_AGENT_TEST_LEAD_IDS=19884275
#
# Kommo → buffer (sem Evolution): a cada tick do scheduler, lê notas / eventos / histórico
# Amojo e empurra texto novo no message_buffer antes de processar.
# KOMMO_INBOUND_POLL_ENABLED=true
#
# Modo (KOMMO_INBOUND_POLL_MODE):
#   notes      = GET /api/v4/leads/{id}/notes + por default também eventos
#                incoming_chat_message (KOMMO_INBOUND_POLL_NOTES_ALSO_EVENTS, default true).
#                O valor "note" (singular) é aceito como alias de "notes".
#   events     = GET /api/v4/events?filter[type]=incoming_chat_message (log nativo
#                do Kommo). Útil quando a integração não cria nota — porém algumas
#                contas (Chats API/Z-API) também não emitem evento de chat na v4.
#   dispatcher = GET /api/kommo/messages/by-lead/{lead_id} no serviço interno
#                banco-kommo-dispatcher (FastAPI). RECOMENDADO quando esse
#                serviço já está rodando no mesmo network do EasyPanel.
#                Precisa apenas de KOMMO_DISPATCHER_URL.
#   amojo      = histórico Amojo direto (Chats API). Precisa secret+scope+chat_id.
#   both       = só notas v4 (igual ao fluxo “só Kommo”). Eventos v4 opcionais:
#                KOMMO_INBOUND_POLL_ALSO_POLL_EVENTS=true
#   all        = notes + events + dispatcher + amojo (cada um só roda se possível).
# Com mode=both, eventos v4 ficam desligados por padrão (só Kommo / notas).
# KOMMO_INBOUND_POLL_ALSO_POLL_EVENTS=false
# KOMMO_INBOUND_POLL_MODE=dispatcher
#
# Fallback automático (sem criar o serviço banco-kommo-dispatcher no Easypanel):
# Se KOMMO_INBOUND_POLL_MODE=dispatcher ou all e o HTTP do dispatcher der
# ENOTFOUND/ECONNREFUSED no boot, o processo força KOMMO_INBOUND_POLL_MODE=notes
# (somente notas v4 / Bearer). Para eventos v4 junto com notas: mode=both e
# KOMMO_INBOUND_POLL_ALSO_POLL_EVENTS=true.
# KOMMO_INBOUND_POLL_DISPATCHER_FALLBACK=false
#
# (modo notes) Default: NOTE_TYPES já inclui "common" (WhatsApp no Kommo). Se INCLUDE_COMMON
# estiver vazio, common entra; use INCLUDE_COMMON=false só para desligar explicitamente.
# O agente filtra ecos das respostas da IA (sufixo " - EX-AAMMDD-HHMM-NNN").
# KOMMO_INBOUND_POLL_NOTE_TYPES=sms_in,extended_service_message,service_message,common
# KOMMO_INBOUND_POLL_INCLUDE_COMMON=
#
# Com mode=notes, mensagens de chat do WhatsApp costumam estar no log de eventos v4;
# por default o poll usa incoming_chat_message em filter[type] (incoming_message dá 400 no Kommo).
# Desligue só notas puras:
# KOMMO_INBOUND_POLL_NOTES_ALSO_EVENTS=false
# Compare no CRM: node --env-file=.env scripts/kommoLeadFeedProbe.mjs 19884275
#
# Warmup (modo notes): se o maior id de nota for de agente/sistema acima da última msg do
# cliente, o cursor antigo deixava fresh=0 para sempre. Tail-seed (default ligado) empurra
# uma vez essa última msg inbound; dedupe com Redis SET NX (chave kommo:poll:tailseed:v1:…).
# KOMMO_INBOUND_POLL_NOTES_TAIL_SEED_ON_WARMUP=true
# KOMMO_INBOUND_POLL_TAIL_SEED_DEDUPE_SEC=604800
#
# Debug do poll (logs extras por lead): KOMMO_INBOUND_POLL_DEBUG=true OU
# KOMMO_INBOUND_POLL_DEBUG_LEAD_IDS=19884275,21208023
# KOMMO_INBOUND_POLL_DEBUG=false
# KOMMO_INBOUND_POLL_DEBUG_LEAD_IDS=
#
# (modo events) Inbound com id ainda não processado: pode ter created_at muito
# antes do cursor (contact vs lead). Janela máxima a partir de "agora" (default 10 anos).
# KOMMO_INBOUND_POLL_UNSEEN_INCOMING_MAX_AGE_SEC=315360000
#
# (modo events) Janela de catch-up: eventos incoming com id ainda não visto entram em `fresh`
# mesmo se created_at for um pouco anterior ao cursor (ex.: entity=contact vs lead).
# 0 = desliga (só at >= cursor). Default 604800 (7 dias). Máx. 30 dias.
# KOMMO_INBOUND_POLL_EVENT_CATCHUP_SEC=604800
#
# (modo events / complemento em mode=notes) Tipos no GET /api/v4/events (máx. 250 por request).
# Default no código: incoming_chat_message (incoming_message em filter[type] costuma retornar 400 "Invalid params").
# KOMMO_INBOUND_POLL_EVENT_TYPES=incoming_chat_message
#
# Ignorar resumos longos em 3ª pessoa (integração / CRM), ex. "O candidato realizou…".
# Aplica-se a notas common, service_message e extended_service_message (não a sms_in).
# KOMMO_INBOUND_POLL_SKIP_CRM_SUMMARY_COMMON=true
# KOMMO_INBOUND_POLL_EVENTS_LIMIT=250
#
# (WABA sem texto no evento v4) Sem KOMMO_CHANNEL_SECRET+SCOPE_ID o código NÃO chama Amojo;
# cai no fallback de notas (abaixo). Se as notas forem só resumo de CRM, desligue o fallback:
# KOMMO_INBOUND_POLL_WABA_NOTES_FALLBACK=true
# Janela ±segundos entre created_at do evento e da nota (default 900).
# KOMMO_INBOUND_POLL_WABA_NOTE_TIME_WINDOW_SEC=900
#
# (modo amojo) Credenciais da Chats API. Também usadas quando mode=events/both e o
# evento WABA vem sem texto (só id+talk_id): o agente busca o body no histórico Amojo.
# Desligue o preenchimento com: KOMMO_INBOUND_POLL_WABA_AMOJO_FILL=false
# KOMMO_CHANNEL_SECRET=
# KOMMO_CHANNEL_SCOPE_ID=
# KOMMO_AMOJO_BASE=https://amojo.kommo.com
# KOMMO_LEAD_CHAT_MAP={"19884275":"uuid-do-chat"}
#
# Endpoints úteis para debug, com a app rodando (no browser use URL completa: http://localhost:PORT ou host público):
#   GET http://localhost:8000/api/kommo/poll/chat-history?leadId=19884275&historyLimit=30
#       (GET /api/v4/contacts/chats + talks + Amojo; KOMMO_ACCESS_TOKEN só CRM pode dar 400 "Channel must be linked" em chats)
#   GET http://localhost:8000/api/kommo/poll/events?leadId=19884275&hours=48&limit=50
#   GET http://localhost:8000/api/kommo/poll/events?leadId=19884275&hours=240&types=*            (lista TODOS os tipos)
#   GET http://localhost:8000/api/kommo/poll/events?entity=contact&entityId=N&hours=240&types=*  (no contato)
#   GET http://localhost:8000/api/kommo/poll/dispatcher?leadId=19884275&limit=20                 (mensagens do dispatcher)
#   GET http://localhost:8000/api/evolution/typing-test?to=5511XXXXXXXXX&delayMs=8000            (testa "digitando..." Evolution)
#   GET http://localhost:8000/api/evolution/health             (inclui kommoPoll.{events,dispatcher}ByLead)
#
# banco-kommo-dispatcher (rede interna do EasyPanel) — fonte recomendada
# quando a API v4 do Kommo não expõe a mensagem do cliente (Chats API):
# KOMMO_DISPATCHER_URL=http://banco-kommo-dispatcher:8000
#   GET /api/kommo-dispatcher/openapi-summary           (lista todas as rotas)
#   GET /api/kommo-dispatcher/probe?path=/api/kommo/dashboard/stats
#   GET /api/kommo-dispatcher/probe?path=/api/kommo/messages/by-lead/19884275&limit=10

# ── Job de feedback (cron no server e no Vite dev) ──
# FEEDBACK_JOB_ENABLED=true
# FEEDBACK_JOB_WINDOW_MINUTES=90
# FEEDBACK_JOB_BUFFER_MINUTES=30
# FEEDBACK_JOB_MAX_WINDOW_MINUTES=0
# Intervalo esperado entre runs (min); acima disso amplia o lookback até MAX_LOOKBACK_EXTENSION
# FEEDBACK_JOB_EXPECTED_INTERVAL_MINUTES=60
# FEEDBACK_JOB_MAX_LOOKBACK_EXTENSION_MINUTES=120
# true = um “cron” por hora UTC no cluster (recomendado com várias réplicas)
# FEEDBACK_JOB_USE_HOUR_SLOT_LOCK=true
# true = catch-up ao subir o processo (pode duplicar com cron se não usar slot lock)
# FEEDBACK_JOB_STARTUP_CATCHUP=false
# Limite (em minutos) acima do qual o dashboard exibe alerta de "fonte sem dados"
# para a tabela mensagens_atendimento_comercial (default 180 = 3 horas)
# FEEDBACK_JOB_SOURCE_STALE_AFTER_MINUTES=180

# Robustez do feedback comercial
# FEEDBACK_JOB_REAP_AFTER_MINUTES=30        # runs presos em 'running' por mais que isso são marcados como erro (default 30)
# FEEDBACK_JOB_WATCHDOG_MINUTES=30          # tempo máximo de um único run antes do scheduler liberar o lock (default 30)

# ── Buffer de mensagens do WhatsApp (debounce entre mensagens do lead) ──
# Seleção automática: 1) Redis se configurado, 2) Supabase (principal) como fallback
# persistente, 3) memória (não persiste em restart).
#
# Supabase (recomendado, default): precisa das envs SUPABASE_URL/SUPABASE_KEY acima
# e da tabela criada uma única vez (SQL):
#   CREATE TABLE message_buffer (
#     id bigserial PRIMARY KEY,
#     session_id text NOT NULL,
#     content text NOT NULL,
#     created_at timestamptz NOT NULL DEFAULT now()
#   );
# Anti-duplicidade: mesma frase na mesma sessão em poucos segundos (webhook + poll Kommo).
# Omitido = 120s. Use 0 para desligar.
# MESSAGE_INGEST_DEDUPE_SEC=120
# Nome da tabela (default: message_buffer)
# MESSAGE_BUFFER_TABLE=message_buffer
#
# Redis (opcional — só se quiser priorizar Redis em vez de Supabase):
# REDIS_URL=redis://:senha@host:6379/0
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# REDIS_KEY_PREFIX=wa:msg:
#
# Forçar backend: redis | supabase | memory (sem valor = auto conforme acima)
# MESSAGE_BUFFER_BACKEND=
# TTL das mensagens no buffer (segundos). Default 600 = 10 min.
# Se um lead manda mensagem mas nunca entra no funil da IA, as mensagens
# dele expiram automaticamente depois desse tempo.
# MESSAGE_BUFFER_TTL_SEC=600

# ── Webhook Evolution API ──
# Token opcional — se setado, a Evolution precisa enviar X-Webhook-Token ou Authorization: Bearer <token>
# EVOLUTION_WEBHOOK_TOKEN=
#
# TESTE / segurança: só estes telefones (só dígitos, separados por vírgula) são
# aceites no buffer ao receber messages.upsert / cloud contact. Vazio = qualquer número.
# Combine com KOMMO_AGENT_TEST_LEAD_IDS (scheduler) para restringir lead + Evolution.
# EVOLUTION_INGEST_PHONE_ALLOWLIST=5511945722117

# ── Fan-out: repassa todo POST do /api/evolution/webhook para outras URLs ──
# Use isso pra ter UMA webhook configurada na Evolution e replicar
# o mesmo payload pro n8n (ou outros). Fire-and-forget — não bloqueia
# o processamento da IA, falhas não afetam a resposta ao lead.
# CSV: vírgula, espaço ou ; separam múltiplas URLs.
# EVOLUTION_WEBHOOK_FORWARD_URL=https://n8n-new-n8n.ca31ey.easypanel.host/webhook/comercial_cruzeiro
# EVOLUTION_WEBHOOK_FORWARD_TIMEOUT_MS=8000
#
# Filtros do fan-out. Default: só repassa messages.upsert (mensagens reais
# do lead) e ignora ecos do bot (fromMe=true). Sobrescreva se quiser
# repassar mais eventos.
# EVOLUTION_WEBHOOK_FORWARD_EVENTS=messages.upsert
# EVOLUTION_WEBHOOK_FORWARD_INCLUDE_FROM_ME=false

#
# Instância WhatsApp Business (Meta) via Evolution: o messages.upsert usa o JID do
# NEGÓCIO em key.remoteJid. Este app combina com contacts.upsert / contacts.update
# (telefone do lead em data.remoteJid). Ative esses eventos no webhook da instância.
# Se sender do payload não bater com remoteJid, defina o JID do WhatsApp Business:
# WHATSAPP_BUSINESS_JID=5511999999999@s.whatsapp.net
# (ou EVOLUTION_CLOUD_BUSINESS_JID=…, mesmo valor)

# ── Indicador "digitando..." ──
# É disparado UMA vez, no início do flush (depois do debounce de 15s).
# A IA processa + envia → cliente vê "digitando..." durante esse tempo.
#
# Caminho 1 (preferencial): WhatsApp Cloud API (Meta). Usa o wamid da
# última mensagem recebida do cliente (cache em memória, TTL 23h).
# Funciona quando a instância da Evolution está integrada via Cloud API
# e ela forwarda os wamids no webhook (data.key.id começa com "wamid.").
# Não precisa de env extra — usa WHATSAPP_PHONE_NUMBER_ID + TOKEN.
#
# Caminho 2 (fallback): Evolution presence (POST /chat/sendPresence).
# Só funciona em instâncias Baileys; instâncias Cloud API rejeitam com
# "Method not available on WhatsApp Business API". Sem essas envs, o
# fallback é silenciosamente desligado.
# EVOLUTION_API_URL=https://evolution.meudominio.com
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# EVOLUTION_TYPING_DELAY_MS=1200

# ── Modelos OpenAI por papel (registry centralizado) ──
#
# Cada "papel" tem sua própria env. A resolução é:
#   1. OPENAI_MODEL_TOOL_<NOME_TOOL>           (override por tool específica)
#   2. OPENAI_MODEL_<PAPEL>                    (env do papel — abaixo)
#   3. envs legadas (OPENAI_AGENT_MODEL, OPENAI_MODEL, OPENAI_TRANSCRIBE_MODEL,
#      OPENAI_VISION_MODEL, FEEDBACK_JOB_OPENAI_MODEL, OPENAI_FEEDBACK_MODEL)
#   4. default por papel (no `server/ai/modelRegistry.js`).
#
# Não precisa setar nada se o default já te atende. As linhas abaixo
# mostram a config recomendada (mais qualidade que o default antigo
# `gpt-4o-mini`, mantendo custo baixo).

# Cérebro do agente: decide qual tool chamar e formula a resposta final.
# IMPACTO: maior — afeta toda conversa.
# Default: gpt-4.1-mini (sucessor do 4o-mini com melhor function calling).
# OPENAI_MODEL_ORCHESTRATOR=gpt-4.1-mini

# Reescrita de query antes da busca vetorial (RAG fusion). Roda antes
# de buscar_precos / _informacoes / _pos / _perguntas. NUNCA inventa
# fato — só reformula em palavras-chave; se duvidar, devolve a query
# original. Modelo BARATO (centavos por mil mensagens).
# Para DESLIGAR completamente: AI_QUERY_REWRITE_ENABLED=false
# OPENAI_MODEL_QUERY_REWRITE=gpt-4.1-nano
# AI_QUERY_REWRITE_ENABLED=true

# Resumo do lead ao criar inscrição (tool `inscricao`).
# OPENAI_MODEL_INSCRICAO=gpt-4.1-mini

# Resumo do lead ao distribuir para humano (tool `distribuir_humano`).
# OPENAI_MODEL_DISTRIBUIR_HUMANO=gpt-4.1-mini

# Job de feedback (análise de qualidade da conversa em background).
# OPENAI_MODEL_FEEDBACK=gpt-4.1-mini

# Visão: analisa imagens enviadas pelo cliente (print de comprovante etc.).
# OPENAI_MODEL_VISION=gpt-4.1-mini

# Transcrição de áudio do cliente. Whisper-1 ainda é a opção mais
# barata e boa em PT-BR. (gpt-4o-transcribe é mais caro, raramente
# vale a pena.)
# OPENAI_MODEL_TRANSCRIBE=whisper-1

# Embeddings das buscas RAG. text-embedding-3-small é ótimo e barato;
# o "large" custa 6.5x mais, raramente vale a pena.
# OPENAI_MODEL_EMBEDDINGS=text-embedding-3-small

# Override por tool específica — formato OPENAI_MODEL_TOOL_<NOME_TOOL_UPPER>.
# Quase nunca necessário. Se usado, sobrescreve o papel correspondente.
# Exemplos (descomente só se quiser):
# OPENAI_MODEL_TOOL_BUSCAR_PRECOS=gpt-4.1-mini
# OPENAI_MODEL_TOOL_INSCRICAO=gpt-4.1-mini

# Quantas mensagens do n8n_chat_histories injetar como turnos anteriores (default: 8)
# AGENT_HISTORY_CONTEXT=8

# ── Legados (continuam funcionando, mas as envs por papel acima têm prioridade) ──
# OPENAI_AGENT_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_VISION_MODEL=gpt-4o-mini
# FEEDBACK_JOB_OPENAI_MODEL=gpt-4o-mini
# OPENAI_FEEDBACK_MODEL=gpt-4o-mini

# ── Envio de resposta pelo WhatsApp Cloud API (Meta/WACA) ──
# Usado no final do fluxo do webhook Evolution: depois que o agente responde,
# a gente divide a resposta em partes (smartSplit) e envia por aqui, criando
# uma nota no Kommo para cada parte (como o fluxo "envio mensagem.txt" do n8n).
# Phone Number ID do WhatsApp Business (no Meta Business)
# WHATSAPP_PHONE_NUMBER_ID=440327379171310
# Access token do Meta (WACA)
# WHATSAPP_ACCESS_TOKEN=
# Versão da Graph API (default v19.0)
# WHATSAPP_API_VERSION=v19.0
# Tamanho máximo de cada pedaço (default 1000, mesmo valor do n8n)
# WHATSAPP_MAX_CHARS=1000
# Espera entre pedaços (default 1000ms, mesmo valor do n8n)
# WHATSAPP_CHUNK_DELAY_MS=1000

# === Kommo Events (auditoria D-1) ===
KOMMO_EVENTS_ENABLED=true
KOMMO_EVENTS_CRON_HOUR_UTC=5
KOMMO_EVENTS_GROUP_SIZE=10
KOMMO_EVENTS_DELAY_PAGE_MS=2500
KOMMO_EVENTS_DELAY_GROUP_MS=45000
KOMMO_EVENTS_MAX_RETRIES_PAGE=3
KOMMO_EVENTS_WATCHDOG_MINUTES=60
KOMMO_EVENTS_STARTUP_CATCHUP=false

# === Aprendizado IA (captura conversas de convertidos + análise de batch) ===
IA_LEARNING_ENABLED=true
IA_LEARNING_DETECTOR_CRON_HOUR_UTC=11
IA_LEARNING_MIN_BATCH_SIZE=50
# Teto de segurança por batch para não estourar contexto do modelo analisador.
# Quando há mais pendentes, o batch consome até este valor; o restante fica
# pra próxima rodada. Default 200.
IA_LEARNING_MAX_BATCH_SIZE=200
IA_LEARNING_MIN_SUPPORT=5
IA_LEARNING_MIN_EXAMPLE_QUALITY=3
# Quantidade de exemplos por batch. Vazio/0 = auto (2 → max(5, batchSize/10)).
# Ex: batch de 200 → até 20 exemplos. Ajuste se quiser mais ou menos diversidade.
IA_LEARNING_MIN_EXAMPLES_PER_BATCH=
IA_LEARNING_MAX_EXAMPLES_PER_BATCH=
IA_LEARNING_ANALYZER_AUTO_CRON_ENABLED=false
IA_LEARNING_FEWSHOT_ENABLED=true
IA_LEARNING_FEWSHOT_K=5
IA_LEARNING_FEWSHOT_MAX_TOKENS=1200
OPENAI_MODEL_LEARNING_ANALYZER=o3-mini
KOMMO_ACEITE_STATUS_ID=48566207
KOMMO_ACEITE_PIPELINE_ID=5481944

# === Aceite Sync (sync paralelo sem filtro por consultor — captura automações) ===
IA_LEARNING_ACEITE_SYNC_ENABLED=true
IA_LEARNING_ACEITE_SYNC_CRON_HOUR_UTC=12

# ── Feedback IA — avalia execuções da IA quando o lead sai do status escutado ──
# Liga/desliga deteção e processamento. Default true.
# IA_FEEDBACK_ENABLED=true
# Modelo OpenAI para o avaliador (default gpt-4.1).
# OPENAI_MODEL_IA_FEEDBACK=gpt-4.1
# Mínimo de turnos da IA na conversa para avaliar (senão pendente). Default 3.
# IA_FEEDBACK_MIN_TURNS=3
# Máximo de linhas de chat_messages lidas por lead. Default 200.
# IA_FEEDBACK_CONVERSA_LIMIT=200
